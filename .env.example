# ============================================================================
# Network Marketing Mastery - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control (already in .gitignore)

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL="mysql://user:password@host:port/database"

# ============================================================================
# Authentication & JWT
# ============================================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
OAUTH_SERVER_URL="https://api.manus.im"
VITE_OAUTH_PORTAL_URL="https://auth.manus.im"

# ============================================================================
# Manus App Configuration
# ============================================================================
VITE_APP_ID="your-manus-app-id"
VITE_APP_TITLE="Network Marketing Mastery"
VITE_APP_LOGO="/logo.png"

# ============================================================================
# Owner Information
# ============================================================================
OWNER_OPEN_ID="your-owner-open-id"
OWNER_NAME="Your Name"

# ============================================================================
# Manus Forge APIs (Built-in Services)
# ============================================================================
# Server-side API access
BUILT_IN_FORGE_API_URL="https://forge.manus.im"
BUILT_IN_FORGE_API_KEY="your-backend-api-key"

# Frontend API access
VITE_FRONTEND_FORGE_API_URL="https://forge.manus.im"
VITE_FRONTEND_FORGE_API_KEY="your-frontend-api-key"

# ============================================================================
# Analytics
# ============================================================================
VITE_ANALYTICS_ENDPOINT="https://analytics.manus.im"
VITE_ANALYTICS_WEBSITE_ID="your-website-id"

# ============================================================================
# Hotmart Integration (Optional - for production)
# ============================================================================
# Update the HOTMART_CHECKOUT_URL constant in client/src/pages/Home.tsx
# with your actual Hotmart product URL
# Example: https://pay.hotmart.com/YOUR_PRODUCT_CODE

# ============================================================================
# Development vs Production
# ============================================================================
NODE_ENV="development"  # or "production"

# ============================================================================
# Notes
# ============================================================================
# 1. All VITE_* variables are exposed to the frontend
# 2. Variables without VITE_ prefix are server-side only
# 3. For Cloudflare Workers deployment, use wrangler secrets instead
# 4. See DEPLOYMENT.md for Cloudflare-specific configuration
